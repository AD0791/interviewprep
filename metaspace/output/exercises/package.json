    "l3": "node --experimental-strip-types solutions/03_read_a_contract.ts",
    "l4": "node --experimental-strip-types solutions/04_sign_and_recover.ts",
    "l5": "node --experimental-strip-types solutions/05_siwe_express.ts",
    "l6": "node --experimental-strip-types solutions/06_read_events.ts",
    "l7": "node --experimental-strip-types solutions/07_indexer.ts",
    "l8": "node --experimental-strip-types solutions/08_reorg.ts",
    "l9": "node --experimental-strip-types solutions/09_relayer.ts",
    "l10": "node --experimental-strip-types solutions/10_voucher_eip712.ts",
    "l11": "node --experimental-strip-types solutions/11_reentrancy.ts",
    "l12": "node --experimental-strip-types solutions/12_full_loop.ts"
  },
  "dependencies": {
    "@ethereumjs/common": "^10.1.3",
    "@ethereumjs/evm": "^10.1.3",
    "@ethereumjs/util": "^10.1.3",
    "express": "^5.2.1",
    "viem": "^2.56.8"
