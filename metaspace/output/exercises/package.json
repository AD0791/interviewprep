{
  "name": "metaspace-exercises",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The twelve-level exercise ladder for the Metaspace technical interview. Node/TS path: Express 5 + viem 2.",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "l1": "node --experimental-strip-types solutions/01_hash_and_address.ts",
